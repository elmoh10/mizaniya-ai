rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function getFamilyRole(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
    }

    function isFamilyAdminOrParent(familyId) {
      return isFamilyMember(familyId) &&
        (getFamilyRole(familyId) == 'ADMIN' || getFamilyRole(familyId) == 'PARENT');
    }

    function doesNotModifyPrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'admin', 'subscriptionTier', 'billingStatus', 'adminFlags', 'securityFlags', 'financialHealthResults']);
    }

    // User Profile Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'admin', 'subscriptionTier', 'billingStatus', 'adminFlags', 'securityFlags', 'financialHealthResults']);
      allow update: if isOwner(userId) && (resource == null || doesNotModifyPrivilegedFields());
      allow delete: if false; // User deletion MUST occur via backend API workflow

      // Sensitive financial subcollections - Server-Only Write Enforcement
      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /bills/{billId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /installments/{installmentId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /debts/{debtId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API

        match /payments/{paymentId} {
          allow read: if isOwner(userId);
          allow write: if false; // Must use authenticated backend API
        }
      }

      match /obligations/{obligationId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /memory/{memoryId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /ai_memories/{memoryId} {
        allow read: if isOwner(userId);
        allow write: if false; // Must use authenticated backend API
      }

      match /ai_conversations/{agentId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Shared Family Accounts (RBAC: ADMIN, PARENT, SPOUSE, CHILD, VIEWER)
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isAuthenticated();
      allow update, delete: if isFamilyAdminOrParent(familyId);

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if isFamilyAdminOrParent(familyId);
        allow update: if isFamilyAdminOrParent(familyId) ||
          (isFamilyMember(familyId) && request.auth.uid == memberId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'spendingLimit', 'approvalThreshold']));
      }

      match /sharedTransactions/{txId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyMember(familyId) && getFamilyRole(familyId) != 'VIEWER';
      }
    }

    // System Feature Flags & System Metrics (Admin restricted)
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.token.admin == true;
    }
  }
}
